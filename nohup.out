queryObject > queryPayload >  {"sql":"SELECT t_col_list_map.createby, t_col_list_map.sql, '[' || t_col_list_map.col_id || ']' || tab1.description AS col_id, '[' || t_col_list_map.list_group_id || ']' || tab2.description AS list_group_id, t_col_list_map.id, t_col_list_map.pid, t_col_list_map.createddate FROM t_col_list_map LEFT JOIN t_group_members tab1 ON tab1.id = t_col_list_map.col_id LEFT JOIN t_group_members tab2 ON tab2.id = t_col_list_map.list_group_id","params":[]}
