queryObject > queryPayload >  {"sql":"SELECT t_document.id, t_document.pid, t_document.document_type, t_document.description, t_document.uri, '[' || t_document.status || ']' || tab1.description AS status, t_document.file, t_document.createdby, t_document.createddate, t_document.updatedby, t_document.updateddate, '[' || t_document.delflag || ']' || tab2.description AS delflag FROM t_document LEFT JOIN t_group_members tab1 ON tab1.id = t_document.status LEFT JOIN t_group_members tab2 ON tab2.id = t_document.delflag","params":[]}
