queryObject > queryPayload >  {"sql":"SELECT t_group_members.id, '[' || t_group_members.pid || ']' || tab1.label AS pid, t_group_members.label, t_group_members.description, '[' || t_group_members.status || ']' || tab2.description AS status, t_group_members.createdby, t_group_members.createddate, t_group_members.updatedby, t_group_members.updateddate, '[' || t_group_members.delflag || ']' || tab3.description AS delflag FROM t_group_members LEFT JOIN t_group tab1 ON tab1.id = t_group_members.pid LEFT JOIN t_group_members tab2 ON tab2.id = t_group_members.status LEFT JOIN t_group_members tab3 ON tab3.id = t_group_members.delflag","params":[]}
