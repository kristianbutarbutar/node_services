queryObject > queryPayload >  {"sql":"SELECT t_mn.id, t_mn.pid, t_mn.label, t_mn.description, '[' || t_mn.status || ']' || tab1.description AS status, t_mn.pub_tsx, t_mn.icon, t_mn.level, t_mn.seqno, t_mn.formid, t_mn.target_tsx, t_mn.root_menu FROM t_mn LEFT JOIN t_group_members tab1 ON tab1.id = t_mn.status LEFT JOIN t_group_members tab2 ON tab2.id = t_mn.formid WHERE t_mn.level = $1 AND t_mn.pid = $2 ORDER BY t_mn.seqno DESC","params":[{"value":1,"type":"INT"},{"value":"ROOT","type":"STRING"}]}
