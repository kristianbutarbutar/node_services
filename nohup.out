getTableName:  {"success":true,"count":1,"data":[{"tablename":"t_mn","label":"Forms Menu"}]}  =>  t_mn
queryObject > queryPayload >  {"sql":"SELECT t_mn.id, t_mn.pid, t_mn.label, t_mn.description, '[' || t_mn.status || ']' || tab1.description AS status, t_mn.pub_tsx, t_mn.icon, t_mn.level, t_mn.seqno, t_mn.formid, t_mn.target_tsx, t_mn.root_menu FROM t_mn LEFT JOIN t_group_members tab1 ON tab1.id = t_mn.status LEFT JOIN t_group_members tab2 ON tab2.id = t_mn.formid WHERE t_mn.pid = $1 ORDER BY t_mn.seqno DESC","params":[{"value":"ROOT","type":"STRING"}]}
getTableName:  {"success":true,"count":1,"data":[{"tablename":"t_form","label":"T_FORM"}]}  =>  t_form
queryObject > queryPayload >  {"sql":"SELECT t_form.id, t_form.pid, t_form.label, t_form.description, t_form.tableName, '[' || t_form.issql || ']' || tab1.description AS issql, t_form.sqlid, '[' || t_form.status || ']' || tab2.description AS status, t_form.createdby, t_form.createddate, t_form.updatedby, t_form.updateddate, '[' || t_form.delflag || ']' || tab3.description AS delflag, t_form.orderby, t_form.groupby, t_form.filetemplate FROM t_form LEFT JOIN t_group_members tab1 ON tab1.id = t_form.issql LEFT JOIN t_group_members tab2 ON tab2.id = t_form.status LEFT JOIN t_group_members tab3 ON tab3.id = t_form.delflag WHERE t_form.status = $1","params":[{"value":"active","type":"STRING"}]}
