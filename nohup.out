queryObject > queryPayload >  {"sql":"SELECT t_group.id, t_group.pid, t_group.label, t_group.description, '[' || t_group.status || ']' || tab1.description AS status, t_group.createdby, t_group.createddate, t_group.updatedby, t_group.updateddate, '[' || t_group.delflag || ']' || tab2.description AS delflag FROM t_group LEFT JOIN t_group_members tab1 ON tab1.id = t_group.status LEFT JOIN t_group_members tab2 ON tab2.id = t_group.delflag WHERE t_group.label  like  $1","params":[{"value":"Group Document Types","type":"VARCHAR"}]}
